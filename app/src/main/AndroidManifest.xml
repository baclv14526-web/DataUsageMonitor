<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Đọc thống kê lưu lượng qua NetworkStatsManager -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Đọc thông tin SIM (subscriberId, danh sách SIM active) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Kiểm tra trạng thái mạng hiện tại -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        android:minSdkVersion="34" />

    <!-- Khởi động lại service sau reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Gửi thông báo (Android 13+ cần hỏi runtime) -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />

    <!-- Hiện cảnh báo toàn màn hình kể cả khi khóa máy -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Tắt tối ưu pin để service chạy ổn định -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Giữ CPU đủ lâu để gửi notification khi màn hình tắt -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DataMonitor"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình cảnh báo vượt hạn mức — hiện trên lock screen -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DataMonitor.Alert"
            android:configChanges="orientation|screenSize|fontScale|uiMode" />

        <!-- Màn hình debug — chỉ dùng khi cần chẩn đoán lỗi đo data -->
        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:label="Debug Đo Data"
            android:configChanges="orientation|screenSize|fontScale|uiMode" />

        <!-- Foreground service giám sát data định kỳ 60 giây -->
        <service
            android:name=".DataUsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Khởi động lại service sau reboot hoặc update app -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
