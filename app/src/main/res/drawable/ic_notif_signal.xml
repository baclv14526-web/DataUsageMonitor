        android:fillColor="#FFFFFF"
        android:pathData="M20.8,7.2 Q20.0,6.0 18.8,6.0 Q17.2,6.0 17.2,8.2 Q17.2,10.5 18.8,10.5 Q19.8,10.5 20.2,9.8 L20.2,8.8 L19.2,8.8 L19.2,7.8 L21.2,7.8 L21.2,10.5 Q20.5,11.5 18.8,11.5 Q16.2,11.5 16.2,8.2 Q16.2,5.0 18.8,5.0 Q20.2,5.0 21.2,6.2 Z" />

