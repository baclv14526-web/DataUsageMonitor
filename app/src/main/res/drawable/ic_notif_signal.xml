<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon thông báo NỀN: sóng 5G hiện đại
    - 3 vạch sóng cong tăng dần từ trái sang phải (kiểu WiFi nhưng nằm ngang)
    - Chấm tròn ở góc trái dưới = "nguồn phát sóng"
    - Chữ "5G" nhỏ ở góc phải trên
    Notification icon PHẢI là single-color (trắng/đen), Android tự tô màu.
    viewportWidth/Height = 24 (chuẩn Material Design notification icon)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Chấm nguồn phát sóng -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M3.5,17.5 A1.5,1.5 0 1,1 3.5,14.5 A1.5,1.5 0 0,1 3.5,17.5 Z" />

    <!-- Vạch sóng 1 (gần nhất, nhỏ nhất) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M6.5,15.5 Q8,13.5 6.5,11.5" />

    <!-- Vạch sóng 2 (vừa) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M9,17 Q12,13.5 9,10" />

    <!-- Vạch sóng 3 (xa nhất, lớn nhất) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M11.5,18.5 Q16,13.5 11.5,8.5" />

    <!-- Chữ "5" -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15.2,6.0 L17.8,6.0 L17.8,7.0 L15.2,7.0 L15.2,8.5 Q15.2,9.5 16.0,9.5 L17.8,9.5 L17.8,10.5 L15.8,10.5 Q14.2,10.5 14.2,8.8 L14.2,6.0 Z" />

    <!-- Chữ "G" -->
