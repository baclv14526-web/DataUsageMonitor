<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon app: chảo vệ tinh + sóng. Thiết kế phẳng, 1 màu trắng, chỉ 5 nét:
    chảo, cần thu, đầu thu, 2 vạch sóng, chân đế.
    Toàn bộ nằm trong vùng an toàn 66x66 ở giữa canvas 108x108.
    Vì chỉ dùng 1 màu nên cũng dùng được làm icon đơn sắc (Android 13+).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cụm chảo + sóng: vẽ thẳng đứng rồi xoay 35° để chảo hướng lên phải -->
    <group
        android:pivotX="54"
        android:pivotY="60"
        android:rotation="35"
        android:translateX="-6"
        android:translateY="4">

        <!-- Thân chảo (bát parabol) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M30,56 Q54,84 78,56 Z" />

        <!-- Cần thu -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:pathData="M54,56 L54,39" />

        <!-- Đầu thu -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M50.5,36 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />

        <!-- Sóng trong -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:pathData="M46.34,29.57 A10,10 0 0,1 61.66,29.57" />

        <!-- Sóng ngoài (nhạt hơn để tạo chiều sâu) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.65"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:pathData="M40.21,24.43 A18,18 0 0,1 67.79,24.43" />
    </group>

    <!-- Chân đế (không xoay) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M43,71 L43,82 M35,83 L51,83" />

</vector>
